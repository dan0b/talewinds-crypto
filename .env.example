# Copy to .env (git-ignored). Every app validates its env at startup and
# refuses to boot if something required is missing or malformed.

# Local Postgres from docker-compose.yml. Credentials are for local dev only.
DATABASE_URL=postgres://talewinds:talewinds@localhost:5432/talewinds

API_PORT=3001
LOG_LEVEL=info

# --- Portfolio ---
# How often balances and prices sync (minutes, 1-59).
PORTFOLIO_SYNC_MINUTES=15
# Holdings worth less than this many USD fold into one "Small balances" line (still counted).
# PORTFOLIO_SMALL_BALANCE_USD=3

# --- Data providers (all optional; free public endpoints are used otherwise) ---
# Needed for Robinhood Chain token balances (its explorer blocks scripts). Free tier:
# https://www.alchemy.com. In your Alchemy app, enable the "Robinhood Chain Mainnet" network.
# ALCHEMY_API_KEY=
# Override RPC endpoints, e.g. a Helius URL for Solana (may contain a key).
# ETHEREUM_RPC_URL=
# ROBINHOOD_RPC_URL=
# SOLANA_RPC_URL=

# --- Coinbase (used from step 02) ---
# A CDP secret API key with **View** permission only and the **ECDSA** algorithm. Paste the
# private key exactly as downloaded, inside double quotes (multi-line is fine).
# COINBASE_API_KEY_NAME=organizations/.../apiKeys/...
# COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----
# ...
# -----END EC PRIVATE KEY-----"

# --- AI (needed from step 05) ---
# ANTHROPIC_API_KEY=
