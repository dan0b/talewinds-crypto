# Copy to .env (git-ignored). Every app validates its env at startup and
# refuses to boot if something required is missing or malformed.

# Local Postgres from docker-compose.yml. Credentials are for local dev only.
DATABASE_URL=postgres://talewinds:talewinds@localhost:5432/talewinds

API_PORT=3001
LOG_LEVEL=info

